{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Issuer": "odontia-api",
    "Audience": "odontia-frontend",
    "SigningKey": "",
    "AccessTokenMinutes": 15
  },
  "Auth": {
    "AllowPublicRegistration": false,
    "RequireConfirmedEmail": true,
    "RefreshTokenDays": 7,
    "SessionMaxDays": 30,
    "InvitationDays": 7,
    "DefaultTimeZone": "America/Argentina/Buenos_Aires",
    "Cookies": {
      "RefreshCookieName": "odontia_rt",
      "CsrfCookieName": "odontia_csrf",
      "CsrfHeaderName": "X-CSRF-Token",
      "Secure": true,
      "SameSite": "Strict",
      "RefreshCookiePath": "/api/v1/auth"
    }
  },
  "Frontend": {
    "BaseUrl": "https://app.example.com",
    "ResetPasswordPath": "/restablecer-contrasena",
    "ConfirmEmailPath": "/confirmar-correo",
    "AcceptInvitationPath": "/aceptar-invitacion"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "AuthPermitPerMinute": 10,
    "RefreshPermitPerMinute": 30,
    "GlobalPermitPerMinute": 600
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Documents": {
    "MaxSizeBytes": 15728640
  },
  "Storage": {
    "Local": {
      "RootPath": ""
    }
  },
  "DataProtection": {
    "KeysPath": ""
  },
  "Email": {
    "Provider": "None",
    "FromAddress": "no-reply@example.com",
    "FromName": "Odontia",
    "Smtp": {
      "Host": "",
      "Port": 587,
      "EnableSsl": true,
      "UserName": "",
      "Password": ""
    }
  },
  "WhatsApp": {
    "Provider": "None"
  },
  "BackgroundJobs": {
    "Enabled": true,
    "ReminderIntervalMinutes": 15,
    "MaintenanceIntervalMinutes": 60
  },
  "ReverseProxy": {
    "Enabled": false,
    "KnownProxies": []
  },
  "Swagger": {
    "Enabled": false
  }
}

# syntax=docker/dockerfile:1
# Imagen del frontend de Odontia (Angular, archivos estáticos servidos con nginx).
# Se construye con contexto en la raíz del repositorio:
#   docker build -f deploy/Dockerfile.web .
# El archivo deploy/Dockerfile.web.dockerignore limita lo que entra al contexto.

# ---------- Etapa 1: compilar Angular ----------
FROM node:24-alpine AS build
WORKDIR /app

# Dependencias primero (capa en caché mientras no cambie package-lock.json).
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund

# Código fuente y compilación de producción (configuración por defecto de angular.json).
COPY frontend/ ./
RUN npm run build

# ---------- Etapa 2: servir estáticos ----------
FROM nginx:alpine AS runtime

# Configuración propia: sin root, pid y temporales en /tmp, fallback de SPA.
COPY deploy/nginx.conf /etc/nginx/nginx.conf
RUN rm -rf /usr/share/nginx/html/* /etc/nginx/conf.d/default.conf \
 && chown -R nginx:nginx /var/cache/nginx

COPY --from=build --chown=nginx:nginx /app/dist/frontend/browser/ /usr/share/nginx/html/

# Docker (20.10+) permite a usuarios sin privilegios abrir el puerto 80 dentro del contenedor.
USER nginx
EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1/index.html || exit 1

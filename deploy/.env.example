# Configuración de Odontia en el servidor. Copiar como deploy/.env (chmod 600).
# actualizar-servidor.sh lo crea solo la primera vez y genera las contraseñas y la clave JWT.
# NUNCA subir el .env real al repositorio.
# Formato: CLAVE=valor, sin comillas ni espacios alrededor del "=".

# Dominio público (ya apunta al servidor). Caddy obtiene el certificado TLS solo.
DOMINIO=odentix.duckdns.org

# Contraseña del usuario de la aplicación (odontia_app) y de root de MySQL.
# Solo letras y números (van dentro de la cadena de conexión). Se generan con: openssl rand -hex 24
# IMPORTANTE: MySQL las aplica solo al crear el volumen por primera vez; cambiarlas después
# requiere hacerlo también dentro de MySQL (ALTER USER).
MYSQL_PASSWORD=CAMBIAR_MYSQL_PASSWORD
MYSQL_ROOT_PASSWORD=CAMBIAR_MYSQL_ROOT_PASSWORD

# Clave para firmar los tokens JWT (mínimo 32 caracteres). Se genera con: openssl rand -hex 32
# Cambiarla cierra todas las sesiones abiertas.
JWT_SIGNING_KEY=CAMBIAR_JWT_SIGNING_KEY

# Servidor de correo saliente (SMTP externo, con STARTTLS). Completar a mano.
SMTP_HOST=CAMBIAR_SMTP_HOST
SMTP_PORT=587
SMTP_USUARIO=CAMBIAR_SMTP_USUARIO
# Dirección que aparece como remitente (debe estar autorizada por el proveedor SMTP).
SMTP_REMITENTE=CAMBIAR_SMTP_REMITENTE
SMTP_CLAVE=CAMBIAR_SMTP_CLAVE

# Registro público de consultorios nuevos. true = cualquiera puede registrarse desde /registro; false = cerrado
# (solo se entra por invitación). Si falta la variable, el registro queda abierto.
PERMITIR_REGISTRO=true

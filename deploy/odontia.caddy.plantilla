# Plantilla del sitio de Odontia para el Caddy compartido (miaula-web-1).
# actualizar-servidor.sh reemplaza __DOMINIO__ y la escribe en ~/sitios-caddy/odontia.caddy.
__DOMINIO__ {
	encode gzip

	# /health/ready (estado de la base) no se publica: lo usa solo el healthcheck dentro del contenedor.
	# /health/live queda accesible para monitoreo externo. Este bloque va primero: Caddy evalúa los
	# "handle" con matchers con nombre en el orden escrito y ejecuta solo el primero que coincide.
	@salud_privada {
		path /health/*
		not path /health/live
	}
	handle @salud_privada {
		respond 404
	}

	@api path /api/* /health/live
	handle @api {
		reverse_proxy odontia-api:8080
	}

	handle {
		reverse_proxy odontia-web:80
	}
}

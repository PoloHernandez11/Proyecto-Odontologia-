# Odontia API — variables de entorno de ejemplo (SIN credenciales reales).
# En ASP.NET Core la jerarquía ":" se escribe "__". En desarrollo prefiera User Secrets (ver README).

ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080

# --- Obligatorias ---
ConnectionStrings__Default=server=mysql.internal;port=3306;database=odontia;user=odontia_app;password=CAMBIAR
Jwt__SigningKey=CAMBIAR_por_una_cadena_aleatoria_de_al_menos_32_caracteres
Jwt__Issuer=odontia-api
Jwt__Audience=odontia-frontend
Jwt__AccessTokenMinutes=15

# --- Frontend / CORS (nunca "*" en producción) ---
Frontend__BaseUrl=https://app.ejemplo.com
Cors__AllowedOrigins__0=https://app.ejemplo.com

# --- Sesiones y cookies ---
Auth__AllowPublicRegistration=false
Auth__RequireConfirmedEmail=true
Auth__RefreshTokenDays=7
Auth__SessionMaxDays=30
Auth__Cookies__Secure=true
# Strict si front y API comparten sitio (app.ejemplo.com / api.ejemplo.com); None si están en sitios distintos.
Auth__Cookies__SameSite=Strict
# Auth__Cookies__Domain=.ejemplo.com

# --- Persistencia de claves y archivos (volúmenes persistentes y privados) ---
DataProtection__KeysPath=/var/odontia/keys
Storage__Local__RootPath=/var/odontia/documents
Documents__MaxSizeBytes=15728640

# --- Correo (SMTP real). Sin esto, los correos NO se envían y quedan registrados como NotSentNoProvider ---
Email__Provider=Smtp
Email__FromAddress=no-reply@ejemplo.com
Email__FromName=Odontia
Email__Smtp__Host=smtp.proveedor.com
Email__Smtp__Port=587
Email__Smtp__EnableSsl=true
Email__Smtp__UserName=CAMBIAR
Email__Smtp__Password=CAMBIAR

# --- WhatsApp: sin proveedor implementado (ver docs/EXTERNAL_SERVICES.md) ---
WhatsApp__Provider=None

# --- Infraestructura ---
Database__ApplyMigrationsOnStartup=false
BackgroundJobs__Enabled=true
ReverseProxy__Enabled=true
ReverseProxy__KnownProxies__0=10.0.0.10
Swagger__Enabled=false
RateLimiting__AuthPermitPerMinute=10
RateLimiting__RefreshPermitPerMinute=30
RateLimiting__GlobalPermitPerMinute=600
